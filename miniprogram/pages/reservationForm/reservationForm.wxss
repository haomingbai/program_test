/**index.wxss**/
page {
  height: 100%;
}

.up{
  color: white;
  display: flex;
  align-items: center;
}

.arrow{
  margin-left: 30rpx;
  width: 10px;
  height: 10px;
  border-bottom:2px solid black ;
  border-left:2px solid black ;
  transform: rotate(45deg);

}

.container {
  background: #f5f5f5;
}
.qrcode-wrap {
  background: #fff;
  border-radius: 33rpx;
}
.qrcode-container {
  padding-top: 10rpx;
  padding-bottom: 50rpx;
  text-align: center;
}
.qrcode-img {
  width: 500rpx;
  height: 500rpx;
}
.text-container {
  padding: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #f0f0f0;
}
.text-input {
  border: 2rpx solid #f5f5f5;
  border-radius: 10rpx;
  margin-right: 10rpx;
  padding: 20rpx;
}
.change-btn {
  width: 200rpx;
  color: #fff;
  padding: 0 50rpx;
}


.wxavatar {
  overflow: hidden;
  display: block;
  width: 230rpx;
  height: 230rpx;
  margin: 20rpx;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 3px 3px 10px rgba(0, 0, 0, 0.2);
}


.input-item{
  border: 1rpx solid #aaaaaa;
  padding: 5px;
  border-radius: 5000px;
  margin-top: 25rpx;
}
.duty-color{
  color: var(--brown);
  font-weight: 500;
}

picker::after {
font-family: "cuIcon";
display: block;
content: "\e6a3";
position: absolute;
font-size: 34rpx;
color: var(--grey);
line-height: 100rpx;
width: 60rpx;
text-align: center;
font-family: "cuIcon";
display: block;
content: "\e6a3";
position: absolute;
font-size: 34rpx;
color: var(--grey);
line-height: 100rpx;
width: 60rpx;
text-align: center;
top: 0;
bottom: 0;
right: -20rpx;
margin: auto;
bottom: 0;
right: -20rpx;
margin: auto;
}
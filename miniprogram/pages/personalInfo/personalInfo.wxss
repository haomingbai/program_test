@import "../../colorui/persion.wxss";
.display {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: auto;
}

.listColumOutside {
  height: auto;
  width: 90%;
  background-color: white;
  border-radius: 20rpx;
}

.listColumInside {
  height: 7vh;
  width: 100%;
  display: flex;
  justify-items: center;
  align-items: center;
}

.listColumInside>image {
  width: 50rpx;
  margin-left: 50rpx;
}

.listModdle {
  width: 480rpx;
  height: auto;
  margin-left: 30rpx;
  font-size: 2vh;
}

.arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid black;
  border-left: 4rpx solid black;
  transform: rotate(135deg);
}

.text-888 {
  color: #888;
}

.img-warp {
  width: 590rpx;
  height: 164rpx;
}

.img-warp image {
  width: 100%;
  height: 100%;
}

.title1 {
  padding: 20rpx 30rpx;
  font-size: 12pt;
  color: #353535;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
}

.title1 view::after {
  display: inline-block;
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #353535;
  border-right: 3rpx solid #353535;
  transform: rotate(45deg);
}

.desc-text {
  color: #FFFFFF !important;
  font-weight: 800;
}

.index-title {
  color: #FFFFFF !important;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 50rpx;
  padding: 0 30rpx;
}

.my-banner {
  /* height: 1129rpx; */
  width: 100%;
  /* height: 300rpx; */
  padding: 0 40rpx;
  height: 220rpx;
  margin-top: 30rpx;
  overflow: hidden;
}

.my-banner image {
  height: 100%;
  width: 100%;
  display: block;
  border-radius: 6rpx;
}

/* projects/A00/team/team.wxss */
.headTitle {
  height: 13vh;
  background-color: #1AAD19;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  width: 45%;
  font-size: large;
}

.backgroundTitle {
  padding-top: 2vh;
  height: auto;
  width: 100%;
  display: flex;
  justify-content: space-around;
  background-color: white;
}




.card {
  background-color: #F8F8F8;
  border: 2rpx solid #E5E5E5;
  width: 85%;
  height: auto;
  padding-top: 0vh;
  padding-bottom: 2vh;
  padding-left: 20rpx;
  padding-right: 20rpx;
  border-radius: 12rpx;
}

.card input {
  background-color: white;
  height: 5vh;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding-left: 20rpx;
}

.card view {
  color: black;
  font-size: 28rpx;
  line-height: 80rpx;
}

.display1 {
  display: flex;
  align-items: center;
  margin-left: 5rpx;
  font-size: 2vh;
}


.text {
  display: flex;
  align-items: center;
  font-weight: 700;
  font-size: 42rpx;
  line-height: 100rpx;
}

.fontSet {
  font-size: 32rpx;
  font-weight: 400;
  margin-left: 2vh;
  line-height: 80rpx;
}

.smallFont {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 60rpx;
  color: #9D9D9D;
  margin-left: 2vh;
}

.box {
  width: 100%;
  height: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.button {
  display: flex;
  width: 85%;
  height: 6vh;
  font-size: normal;
  align-items: center;
  justify-content: center;
  margin-top: 3vh;

}


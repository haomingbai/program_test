<!-- try it -->
<image src="../../res/forshow.png" mode="widthFix" style="width: 100%;"/>

<view style="position: relative;top: -35vh;">
  <view class="scrollPage">
    <view class="UCenter-bg" style="height: 33.9vh;">
      <view class="allUseDisplay" style="width: 100%;width: 750rpx;height: 40.05vh;flex-direction: column;">
        <image src="/../../res/logo.png" mode="widthFix" style="width:150rpx;margin-top: 8vh;" />
        <view class="text-white text-xl">
          {{testName}}
        </view>
        
        <view class="text-white margin-top-sm" >
          {{organizationName}}
        </view>
        <image src="https://raw.githubusercontent.com/weilanwl/ColorUI/master/demo/images/wave.gif" mode="widthFix" style="width: 100%;mix-blend-mode:screen;z-index: 99;margin-top: -4vh;"/>
      </view>
    </view>

    <!-- 下方导航栏 -->
    <view class="padding flex text-center text-grey bg-white shadow-warp" style="border-top-color: white;">
      <view class="flex flex-sub flex-direction solid-right">
        <view class="text-xxl text-orange">{{notSigned}}</view>
        <view class="margin-top-sm">
          <text class="cuIcon-attentionfill"></text>“未报名”
        </view>
      </view>


      <view class="flex flex-sub flex-direction solid-right">
        <view class="text-xxl text-blue">{{studentName}}</view>
        <view class="margin-top-sm">
          <text class="cuIcon-favorfill"></text>“姓名”
        </view>
      </view>


      <view class="flex flex-sub flex-direction">
        <view class="text-xxl text-green">{{Signed}}</view>
        <view class="margin-top-sm">
          <text class="cuIcon-fork"></text> “已报名”
        </view>
      </view>
    </view>
  </view>
</view>








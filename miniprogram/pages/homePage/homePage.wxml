<view style="position: relative;top: -35vh;width: 100%;">
<!-- 比赛列表 -->

<view class="cu-bar justify-center" style="margin-left: 2vh;margin-top: 0vh;z-index:1;">
  <view class="action sub-title" style="justify-content: space-between;height: 100%;width: 100%;">
    <view style="height: 100%;width: auto;display: flex;flex-direction: column;" style="z-index: 20;">
      <text class="text-xl text-bold" style="font-size: medium;z-index: -1;">报名信息</text>
      <text class="text-ABC text-gray" style="display: flex;justify-content: flex-start;">message</text>
    </view>
  </view>
</view>

<!-- 列表信息需要根据用户的情况来选择性报名，选什么课抱什么课程名 -->
<view wx:for="{{reserveExam}}" bindtap="navigateToExam" data-url="../examInform/examInformList" data-cno="{{item}}" class=" shadow-warp margin-top radius" style="display: flex;align-items: flex-start;margin-left: 2vh;margin-right: 2vh;background-color: white;border-bottom-color: #F1F1F1;margin-top: 1.2vh;">
  <view>
    <view style="display: flex;width: 100%;padding: 2.5vh;">
      <image src="../../res/icon.png" mode="heightFix" style="height: 8vh;" />
      <view class="text-xl text-bold" style="font-size: 1.5vh;display: flex;align-items: center;justify-content: center;flex-direction: column;margin-left: 7vh;">
      </view>
    </view>
  </view>

  <view style="height: 100%;width: auto;display: flex;align-items: center;justify-content: center;height: 13vh;">
    <view style="display: flex;width: 100%;padding: 2.5vh;align-items: center;justify-content: center;">
      <view class="text-xl text-bold" style="font-size: 1.5vh;display: flex;align-items: center;justify-content: center;flex-direction: column;line-height: 3vh;">
        <text>考试科目</text>
        <text>{{item}}</text>
      
      </view>
    </view>
  </view>
</view>

<view style="height: 20vh;">

</view>

<view class="box shadow shadow-lg" style="position: fixed;bottom: 0vh;width: 750rpx;z-index: 20;">
  <view class="cu-bar tabbar bg-black shadow shadow-lg" style="background-color: white!important;">
    <view bindtap="navigateToTabbar" data-url="../lookReservation/lookReservation" class="action text-black">
      <view class="cuIcon-time"></view>查看报名
    </view>

    <view class="action text-white add-action ">
      <button bindtap="changeStats" data-class="slide-bottom" class="cu-btn cuIcon-sort bg-red shadow "></button>
      <view class="text-red">
        报名比赛
      </view>
    </view>
    <view bindtap="navigateToTabbar" data-url="../personalInfo/personalInfo" class="action text-black">
      <view class="cuIcon-people">
      </view>
      个人信息
    </view>
  </view>
</view>
</view>





<image src="../../res/forshow.png" style="width: 100%;"/>

<view style="position: relative;top: -24vh;left: 80rpx;">
    <view class="userinfo">
        <!--头像-->
        <view bindtap="logoIn" class="userinfo-avatar bg-white" style="display: flex;align-items: center;justify-content: center;">
            <!-- <open-data type="userAvatarUrl"></open-data> -->
            <image src="../../res/ACM.png" mode="heightFix" style="overflow: hidden;height: 50%;width: 100%;" />
        </view>

        <!--昵称-->
        <view class="box4 text-black" style="z-index: 999; height: 190rpx;justify-content: center;flex-direction: column;align-items: flex-start;">
            <view class="all_use_display" style="width: auto; margin-bottom: 1vh;">
                <view bindtap="toInfo" class="info_name ui-TC" wx:if="{{!name}}" style="color: white;margin-left: 15rpx;font-weight: 600;">登录</view>
                <view class="info_name ui-TC" wx:if="{{name}}" style="color: white;margin-left: 15rpx;font-weight: 600;">{{name}}</view>
                <view bindtap="toInfo" class="margin-top ui-TC" wx:if="{{name}}" style="color: white;margin-left: 15rpx;font-weight: 600;">点此更改信息</view>
            </view>

            <view class="all_use_display shadow bg-yellow padding radius text-center light" style="justify-items: center;text-align: center;padding: 7rpx;font-size: 25rpx;">
                {{data.phone}}
            </view>
        </view>

        <!--箭头-->
        <view bindtap="changeIms" wx:if="{{userName}}" class="cuIcon-right lg text-gray" style="margin-left: 150rpx;font-size: 60rpx;font-weight: 700;">

        </view>


    </view>
</view>


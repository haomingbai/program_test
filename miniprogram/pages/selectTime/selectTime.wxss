/* pages/component/nav/nav.wxss */
.VerticalNav.nav {
  width: 200rpx;
  white-space: initial;
}

.VerticalNav.nav .cu-item {
  width: 100%;
  text-align: center;
  background-color: #fff;
  margin: 0;
  border: none;
  height: 50px;
  position: relative;
}

.VerticalNav.nav .cu-item.cur {
  background-color: #f1f1f1;
}
.VerticalNav.nav .cu-item.cur::after {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 10rpx 0 0 10rpx;
  position: absolute;
  background-color: currentColor;
  top: 0;
  right: 0rpx;
  bottom: 0;
  margin: auto;
}
.VerticalBox{
  display: flex;
}
.VerticalMain{
  background-color: #f1f1f1;
}

.up{
  color: white;
  display: flex;
  align-items: center;
}

.arrow{
  margin-left: 30rpx;
  width: 10px;
  height: 10px;
  border-bottom:2px solid black ;
  border-left:2px solid black ;
  transform: rotate(45deg);

}



page {
    overflow-y: auto !important;
}

.header {
  height: 100px;
  background-color: #ffffff;
  border-bottom: 1px solid #cccccc;
  display: flex;
  align-items: center;
}

.back {
  width: 60px;
  height: 100%;
  display: flex;
  align-items: center;
  padding-left: 20px;
}

.back-icon {
  width: 30px;
  height: 30px;
}

.title {
  flex: 1;
  font-size: 24px;
  color: #333333;
  text-align: center;
}

<image src="../../res/forshow.png" mode="heightFix" style="height: 100vh;position: fixed;z-index: -1;"/>
<view class="allUseDisplay" style="width: 750rpx;height: 100vh;flex-direction: column;">
  <text style="color: white;font-size: 50rpx;">{{organizationShortName}}</text>
  
  <view class="text-white" style="font-size: 60rpx;">
    {{testName}}
  </view>
  <view class="text-white" style="font-size: 40rpx;">
    {{organizationName}}
  </view>
  <!-- <text class="bg-red margin-top" >
    我要报名
  </text> -->

  <view class="allUseDisplay margin-top" style="flex-direction: column;">
    <!-- <view class="action sub-title">
      <text class="text-xl text-bold text-green">关于我们</text>
      <text class="bg-green" style="width:2rem"></text>
      <!-- last-child选择器-->
    <!-- </view> -->
    
    <button bindtap="toNavigate" class="cu-btn margin-tb-sm lg" style="background-color: #E91E63;z-index: 99;color: white;" hidden="{{!enroll}}">
      我要报名   <text class="cuIcon-right"></text>
    </button>
    <button class="cu-btn block line-orange lg" style="margin-top: -5vh;margin-left: 40rpx;" hidden="{{!enroll}}"></button>

    <button bindtap="adminLogin" class="cu-btn margin-tb-sm lg" style="background-color: #808080;z-index: 99;color: white;" hidden="{{!admin}}">
      管理员登陆   <text class="cuIcon-right"></text>
    </button>
    <button class="cu-btn block line-orange lg" style="margin-top: -5vh;margin-left: 40rpx;" hidden="{{!admin}}"></button>
    <button bindtap="teacherLogin" class="cu-btn margin-tb-sm lg" style="background-color: #808080;z-index: 99;color: white;" hidden="{{!teacher}}">
      监考员登陆   <text class="cuIcon-right"></text>
    </button>
    <button class="cu-btn block line-orange lg" style="margin-top: -5vh;margin-left: 40rpx;" hidden="{{!teacher}}"></button>
    <button bindtap="studentSignin" class="cu-btn margin-tb-sm lg" style="background-color: #E91E63;z-index: 99;color: white;" hidden="{{!signin}}">
      考生签到   <text class="cuIcon-right"></text>
    </button>
    <button class="cu-btn block line-orange lg" style="margin-top: -5vh;margin-left: 40rpx;" hidden="{{!signin}}"></button>


  </view>

</view>